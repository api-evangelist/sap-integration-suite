{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP API Management API Products Key Value Maps API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{tenant}.authentication.sap.hana.ondemand.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Key Value Maps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Key Value Maps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api-portal-host}/apiportal/api/1.0/KeyValueMaps"
          },
          "docs": "Retrieve all key-value maps configured in the API Management tenant."
        },
        {
          "info": {
            "name": "Create Key Value Map",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{api-portal-host}/apiportal/api/1.0/KeyValueMaps",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new key-value map for storing configuration data."
        }
      ]
    }
  ],
  "bundled": true
}