{
  "opencollection": "1.0.0",
  "info": {
    "name": "SAP API Management API Products Applications API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{tenant}.authentication.sap.hana.ondemand.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api-portal-host}/apiportal/api/1.0/Management/Applications",
            "params": [
              {
                "name": "$top",
                "value": "",
                "type": "query"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve all developer applications registered in the API portal."
        },
        {
          "info": {
            "name": "Get Application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api-portal-host}/apiportal/api/1.0/Management/Applications(':id')",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application identifier"
              }
            ]
          },
          "docs": "Retrieve a specific developer application by ID."
        }
      ]
    }
  ],
  "bundled": true
}